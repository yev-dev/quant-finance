    "# ═══════════════════════════════════════════════════════════════\n",
    "#  BUILD PRICE PANEL & INJECT DISTRESS\n",
    "# ═══════════════════════════════════════════════════════════════\n",
    "\n",
    "selected = [TARGET_TICKER] + universe['same_sector_peers']\n",
    "raw = prices_wide[selected].dropna().copy()\n",
    "n_avail = min(N_DAYS, len(raw))\n",
    "raw = raw.iloc[-n_avail:]\n",
    "dates = raw.index\n",
    "n_avail = len(raw)\n",
    "\n",
    "# Build price panel\n",
    "prices_df = pd.DataFrame(index=dates)\n",
    "for t in universe['same_sector_peers'] + [TARGET_TICKER]:\n",
    "    prices_df[t] = raw[t]\n",
    "prices_df[TARGET_ORIG_KEY] = raw[TARGET_TICKER]\n",
    "prices_df[DIST_TRUE_KEY] = prices_df[TARGET_ORIG_KEY].copy()\n",
    "\n",
    "# Distress window\n",
    "dist_start = max(40, int(0.60 * n_avail))\n",
    "dist_end = min(dist_start + DIST_LENGTH, n_avail - 5)\n",
    "\n",
    "# Inject sinusoidal corruption\n",
    "obs = prices_df[DIST_TRUE_KEY].values.copy()\n",
    "for i in range(dist_end - dist_start):\n",
    "    obs[dist_start + i] *= 1 - DIST_DEPTH * np.sin(np.pi * i / (dist_end - dist_start - 1))\n",
    "prices_df[DIST_OBS_KEY] = obs\n",
    "\n",
    "print(f'Samples: {n_avail}')\n",
    "print(f'Distress window: {dates[dist_start].date()} → {dates[dist_end-1].date()}')\n",
    "print(f'  indices: {dist_start}–{dist_end-1} ({dist_end - dist_start} days)')\n",
    "print(f'  depth: {DIST_DEPTH*100:.0f}% sinusoidal drop')\n",
    "\n",
    "# Compute returns\n",
    "ret_df = np.log(prices_df[model_peer_cols + [DIST_OBS_KEY]] /\n",
    "                prices_df[model_peer_cols + [DIST_OBS_KEY]].shift(1)).dropna()\n",
    "ret_df = ret_df.rename(columns={DIST_OBS_KEY: 'DIST'})\n",
    "\n",
    "# Visualise the distress\n",
    "fig, ax = plt.subplots(figsize=(14, 5))\n",
    "zs, ze = max(0, dist_start - 20), min(len(dates), dist_end + 20)\n",
    "ax.plot(dates[zs:ze], prices_df[DIST_TRUE_KEY].iloc[zs:ze], 'g-', lw=2, label='True (uncorrupted)')\n",
    "ax.plot(dates[zs:ze], prices_df[DIST_OBS_KEY].iloc[zs:ze], 'r-', lw=1.5, alpha=0.7, label='Observed (corrupted)')\n",
    "ax.axvspan(dates[dist_start], dates[dist_end-1], color='red', alpha=0.1, label='Distress window')\n",
    "ax.set_title(f'{TARGET_TICKER} — Distress Injection: {DIST_DEPTH*100:.0f}% sinusoidal drop over {DIST_LENGTH}d')\n",
    "ax.set_ylabel('Price ($)')\n",
    "ax.legend()\n",
    "ax.xaxis.set_major_formatter(mdates.DateFormatter('%d %b %Y'))\n",
    "plt.setp(ax.xaxis.get_majorticklabels(), rotation=25)\n",
    "ax.grid(alpha=0.2)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
